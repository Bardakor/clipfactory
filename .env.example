# ── Required for AI analysis ────────────────────────────────────────────────
# The only external credential CLIPFACTORY needs. Without it the pipeline still
# runs, but ranking is heuristic-only and clearly labelled as such in the UI.
# Read server-side only; never sent to the browser, never logged.
OPENROUTER_API_KEY=

# ── Optional overrides (defaults shown) ─────────────────────────────────────
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Where sources, caches and exports live. Relative paths resolve from the repo root.
# CLIPFACTORY_DATA_DIR=./data
# CLIPFACTORY_API_PORT=8000
# Largest accepted upload, in GB.
# CLIPFACTORY_MAX_UPLOAD_GB=30
# CLIPFACTORY_LOG_LEVEL=INFO

# ── Test adapters (never use for real work) ─────────────────────────────────
# "fake" replaces OpenRouter / Whisper with deterministic stand-ins. Every job,
# clip and score produced this way is flagged "TEST" in the database and the UI.
# CLIPFACTORY_AI_ADAPTER=openrouter      # openrouter | fake
# CLIPFACTORY_TRANSCRIBER=               # mlx | openrouter | fake (empty = use Settings page)

# Model routing, presets, concurrency, budgets, subtitle defaults and profile
# weights are edited in the dashboard (Paramètres) and stored in SQLite.
